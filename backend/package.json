{
  "name": "moncasin-backend",
  "version": "1.0.0",
  "description": "Backend du casino MonCasin.com",
  "main": "src/server.js",
  "scripts": {
    "postinstall": "npx prisma generate",
    "dev": "nodemon src/server.js",
    "start": "npx prisma db push --accept-data-loss && node prisma/seed.js && node src/server.js",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "5.7.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "prisma": "5.7.0"
  }
}
